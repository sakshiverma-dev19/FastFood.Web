<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FastFood.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>


<body style="background:#f5f7fb;">
    <div id="pageSpinner">

        <div class="spinner-box">

            <div class="spinner-ringg"></div>

            <h5>Loading...</h5>

            <p>Please wait a moment</p>

        </div>

    </div>

    <nav class="navbar navbar-expand-lg admin-navbar py-3">

        <div class="container">


            <!-- Logo -->
            <a class="navbar-brand admin-brand"
               asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">

                <div class="admin-logo">
                    <i class="fa-solid fa-utensils"></i>
                </div>

                <div class="admin-text">
                    <h4>Admin Panel</h4>
                    <small>Fast Food Management</small>
                </div>

            </a>
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="adminNav">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link active-nav"
                           asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Categories"
                           asp-action="Index">
                            Categories
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="SubCategories"
                           asp-action="Index">
                            Sub Categories
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Items"
                           asp-action="Index">
                            Items
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-area="Admin"
                           asp-controller="Orders"
                           asp-action="Index">
                            Orders
                        </a>
                    </li>

                </ul>

                <div class="d-flex align-items-center gap-3">

                    <i class="fa-solid fa-magnifying-glass search-icon"></i>

                    @await Component.InvokeAsync("AdminNotification")
                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="btn btn-danger rounded-pill px-4">

                       

                        Logout

                    </a>

                </div>

            </div>

        </div>

    </nav>
  

      

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-section mt-5">

        <div class="container">

            <div class="row">

                <!-- Logo -->
                <div class="col-md-4 mb-3">

                    <h4 class="footer-logo">
                        🍔 Fast Food
                    </h4>

                    <p class="footer-text">
                        Delicious food delivered fresh at your doorstep.
                        Fast, tasty and affordable meals every day.
                    </p>

                </div>

                <!-- Quick Links -->
                <div class="col-md-4 mb-3">

                    <h5>Quick Links</h5>

                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                        <li><a asp-controller="Home" asp-action="Cart">Cart</a></li>
                    </ul>

                </div>

                <!-- Contact -->
                <div class="col-md-4 mb-3">

                    <h5>Contact</h5>

                    <p>📍 Ayodhya, Uttar Pradesh</p>

                    <p>📞 +91 9876543210</p>

                    <p>✉ fastfood@gmail.com</p>

                </div>

            </div>

            <hr>

            <div class="text-center">

                © 2026 Fast Food Ordering System | All Rights Reserved

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>

        document.querySelectorAll("a").forEach(function(link){

            link.addEventListener("click",function(){

                const href = this.getAttribute("href");

                if(!href ||
                   href.startsWith("#") ||
                   href.startsWith("javascript:") ||
                   this.target === "_blank")
                    return;

                const spinner = document.getElementById("pageSpinner");

                if(spinner){

                    spinner.style.display = "flex";

                }

            });

        });

    </script>
    <script>

        document.querySelectorAll("form").forEach(function(form){

            form.addEventListener("submit",function(){

                const spinner = document.getElementById("pageSpinner");

                if(spinner){

                    spinner.style.display = "flex";

                }

            });

        });

    </script>
</body>
</html>