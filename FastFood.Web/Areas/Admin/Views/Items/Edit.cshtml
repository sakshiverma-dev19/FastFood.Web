@model FastFood.Web.ViewModels.ItemViewModel

<style>
    .edit-card {
        max-width: 520px;
        margin: auto;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        border: none;
        background: #fff;
    }

    .edit-header {
        background: linear-gradient(135deg, #ffc107, #ff9800);
        color: white;
        text-align: center;
        padding: 14px;
        font-size: 20px;
        font-weight: 700;
    }

    label {
        font-weight: 600;
        font-size: 13px;
        color: #444;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #ff9800;
        box-shadow: 0 0 0 0.15rem rgba(255,152,0,0.25);
    }

    .btn-update {
        background: linear-gradient(135deg, #ffc107, #ff9800);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-update:hover {
            transform: scale(1.03);
            opacity: 0.95;
        }

    .btn-back {
        border-radius: 30px;
        font-size: 13px;
    }
</style>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="container mt-5">

    <div class="card edit-card">

        <!-- HEADER -->
        <div class="edit-header">
            Edit Item
        </div>

        <div class="p-4">

            <form asp-area="Admin"
                  asp-controller="Items"
                  asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />




                <div class="mb-2">
                    <label>Name</label>
                    <input asp-for="Name" class="form-control form-control-sm" />
                </div>
                <div class="mb-2">
                    <label>Description</label>
                    <textarea asp-for="Description" class="form-control form-control-sm"></textarea>
                </div>

                <div class="mb-2">
                    <label>Price</label>
                    <input asp-for="Price" class="form-control form-control-sm" />
                </div>

                <div class="mb-2">
                    <label>Category</label>
                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryList"
                            class="form-select form-select-sm">
                    </select>
                </div>
                <div class="mb-3">
                    <label>Image</label>
                    <input asp-for="ImageFile" type="file" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Sub Category</label>
                    <select asp-for="SubCategoryId"
                            asp-items="ViewBag.SubCategoryList"
                            class="form-select form-select-sm">
                    </select>
                </div>

                <div class="d-flex justify-content-between">

                    <button type="submit" class="btn-update">
                        Update
                    </button>

                    <a asp-action="Index" class="btn btn-secondary btn-back">
                        Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>