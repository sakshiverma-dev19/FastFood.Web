@model FastFood.Web.ViewModels.ItemViewModel

<style>
    .glass-card {
        width: 420px;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        overflow: hidden;
        border: none;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #ff4d4d, #ff1a75);
        color: white;
        text-align: center;
        padding: 14px;
        font-size: 20px;
        font-weight: 700;
    }

    .form-control:focus, .form-select:focus {
        border-color: #ff4d4d;
        box-shadow: 0 0 0 0.15rem rgba(255,77,77,0.25);
    }

    label {
        font-weight: 500;
        font-size: 13px;
        color: #444;
    }

    .btn-rounded {
        background: linear-gradient(135deg, #ff4d4d, #ff1a75);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 8px 20px; /* 🔥 chhota button */
        font-size: 13px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-rounded:hover {
            transform: scale(1.03);
            opacity: 0.95;
        }
</style>

<div class="container mt-5 d-flex justify-content-center">

    <div class="glass-card">

        <div class="card-header-custom">
            Create Item
        </div>

        <div class="p-3">

            <form method="post" enctype="multipart/form-data">

                <div class="mb-2">
                    <label>Name</label>
                    <input asp-for="Name" class="form-control form-control-sm" />
                </div>

                <div class="mb-2">
                    <label>Description</label>
                    <textarea asp-for="Description" class="form-control form-control-sm"></textarea>
                </div>

                <div class="mb-2">
                    <label>Price</label>
                    <input asp-for="Price" class="form-control form-control-sm" />
                </div>

                <div class="mb-2">
                    <label>Category</label>
                    <select asp-for="CategoryId"
                            asp-items="ViewBag.CategoryList"
                            class="form-select form-select-sm">
                        <option value="">Select Category</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label>Sub Category</label>
                    <select asp-for="SubCategoryId"
                            asp-items="ViewBag.SubCategoryList"
                            class="form-select form-select-sm">
                        <option value="">Select Sub Category</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label>Image</label>
                    <input asp-for="ImageFile" type="file" class="form-control form-control-sm" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn-rounded">
                        Save Item
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>