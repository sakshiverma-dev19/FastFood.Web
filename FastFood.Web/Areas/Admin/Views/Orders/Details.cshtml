@model IEnumerable<FastFood.Models.OrderDetails>

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold text-danger">
            📦 Order Details
        </h2>

        <span class="badge bg-primary fs-6 px-3 py-2">
            Status : @ViewBag.Status
        </span>

    </div>

    <!-- Buttons -->
    <div class="mb-4">

        <a asp-action="Preparing"
           asp-route-id="@ViewBag.OrderId"
           class="btn btn-warning me-2 px-4">
            🍳 Preparing
        </a>
        @if (ViewBag.Status == "Pending")
        {
            <a asp-action="Preparing"
               asp-route-id="@ViewBag.OrderId"
               class="btn btn-warning px-4">
                🍳 Preparing
            </a>
        }

        @if (ViewBag.Status == "Preparing")
        {
            <a asp-action="OutForDelivery"
               asp-route-id="@ViewBag.OrderId"
               class="btn btn-primary px-4">
                🚚 Out For Delivery
            </a>
        }

        @if (ViewBag.Status == "Out For Delivery")
        {
            <a href="/Admin/Orders/Completed/@ViewBag.OrderId"
               
               class="btn btn-success px-4">
                ✅ Delivered
            </a>
        }
        <a href="/Admin/Orders/Invoice/@ViewBag.OrderId"
          
           class="btn btn-dark px-4">
            🧾 Invoice
        </a>

    </div>

    <!-- Customer Details -->
    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-danger text-white">

            <h5 class="mb-0">
                👤 Customer Details
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <p><strong>👤 Name :</strong> @ViewBag.Order.Name</p>

                    <p><strong>📞 Phone :</strong> @ViewBag.Order.Phone</p>

                    <p>
                        <strong>💳 Payment :</strong>

                        <span class="badge bg-success">
                            @ViewBag.Order.PaymentMethod
                        </span>

                    </p>

                </div>

                <div class="col-md-6">

                    <p><strong>🏠 House No :</strong> @ViewBag.Order.HouseNo</p>

                    <p><strong>🛣 Street :</strong> @ViewBag.Order.Street</p>

                    <p><strong>🏙 City :</strong> @ViewBag.Order.City</p>

                    <p><strong>📮 Pincode :</strong> @ViewBag.Order.Pincode</p>

                    <p><strong>📍 Landmark :</strong> @ViewBag.Order.Landmark</p>

                </div>

            </div>

        </div>

    </div>

    <!-- Food Table -->

    <div class="card shadow border-0">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">
                🍔 Ordered Food Items
            </h5>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover table-striped mb-0 text-center">

                <thead class="table-light">

                    <tr>
                        <th>Food Item</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @item.Item.Name
                            </td>

                            <td>
                                ₹ @item.Price
                            </td>

                            <td>
                                @item.Count
                            </td>

                            <td class="fw-bold text-success">
                                ₹ @(item.Price * item.Count)
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>5