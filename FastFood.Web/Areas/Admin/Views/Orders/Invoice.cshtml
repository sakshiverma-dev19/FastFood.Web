@model IEnumerable<FastFood.Models.OrderDetails>

@{
    var order = ViewBag.Order as FastFood.Models.OrderHeader;
    ViewData["Title"] = "Invoice";
}

<div class="container mt-5 mb-5">

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-danger text-white py-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h2 class="fw-bold mb-1">🍔 FAST FOOD</h2>

                    <small>Fresh Food • Fast Delivery</small>

                </div>

                <div class="text-end">

                    <h3 class="fw-bold mb-1">INVOICE</h3>

                    <span class="badge bg-light text-danger fs-6">
                        #@order!.Id
                    </span>

                    <br />

                    <small>
                        @order.OrderDate.ToString("dd MMM yyyy")
                    </small>

                </div>

            </div>

        </div>
        <p>

            <strong>Payment Status :</strong>

            @if (order.Paymentstatus == "Paid")
            {
                <span class="badge bg-success">

                    Paid

                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark">

                    Pending

                </span>
            }

        </p>
        <div class="card-body p-5">

            <div class="row mb-4">

                <div class="col-md-6">

                    <div class="border rounded-4 p-4 bg-light h-100">

                        <h5 class="text-danger mb-3">
                            👤 Customer Details
                        </h5>

                        <p><strong>Name :</strong> @order.Name</p>

                        <p><strong>Phone :</strong> @order.Phone</p>

                        <p>
                            <strong>Payment :</strong>

                            <span class="badge bg-success">
                                @order.PaymentMethod
                            </span>

                        </p>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="border rounded-4 p-4 bg-light h-100">

                        <h5 class="text-danger mb-3">
                            📍 Delivery Address
                        </h5>

                        <p>@order.HouseNo</p>

                        <p>@order.Street</p>

                        <p>@order.City - @order.Pincode</p>

                        <p>@order.Landmark</p>

                    </div>

                </div>

            </div>

            <table class="table table-hover table-bordered text-center align-middle">

                <thead class="table-danger">

                    <tr>

                        <th>Food Item</th>

                        <th>Price</th>

                        <th>Qty</th>

                        <th>Total</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.Item.Name</td>

                            <td>₹ @item.Price</td>

                            <td>@item.Count</td>

                            <td class="fw-bold text-success">
                                ₹ @(item.Price * item.Count)
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <div class="row mt-5">

                <div class="col-md-6">

                    <h5>

                        Order Status :

                        @if (order.OrderStatus == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (order.OrderStatus == "Preparing")
                        {
                            <span class="badge bg-primary">
                                Preparing
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Delivered
                            </span>
                        }

                    </h5>

                </div>

                <div class="col-md-5 ms-auto">

                    <div class="card border-0 shadow-sm rounded-4">

                        <div class="card-body">

                            <h5 class="text-danger mb-3">
                                💰 Bill Summary
                            </h5>

                            <div class="d-flex justify-content-between">

                                <span>Sub Total</span>

                                <strong>₹ @order.SubTotal</strong>

                            </div>

                            <div class="d-flex justify-content-between mt-2">

                                <span>Discount</span>

                                <strong>₹ @order.CouponDis</strong>

                            </div>

                            <hr />

                            <div class="d-flex justify-content-between">

                                <h4>Total</h4>

                                <h4 class="text-success fw-bold">

                                    ₹ @order.OrderTotal

                                </h4>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="text-center mt-5">

                <button class="btn btn-danger btn-lg rounded-pill px-5"
                        onclick="window.print()">

                    <i class="fa-solid fa-print me-2"></i>

                    Print Invoice

                </button>

            </div>

            <div class="text-center mt-5">

                <i class="fa-solid fa-circle-check text-success"
                   style="font-size:70px;"></i>

                <h3 class="mt-3 text-success fw-bold">

                    Thank You For Ordering ❤️

                </h3>

                <p class="text-muted">

                    We appreciate your order and hope you enjoy your meal.

                </p>

            </div>

            <hr />

            <div class="text-center">

                <small>This is a computer generated invoice.</small>

                <br />

                <small>© 2026 Fast Food Ordering System</small>

            </div>

        </div>

    </div>

</div>

<style>

    @@media print {

        nav,
        footer,
        .btn,
        .navbar,
        .footer,
        .sidebar {
            display: none !important;
        }

        body {
            background: white;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }
    }

</style>