@model FastFood.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<style>
    .form-card {
        max-width: 420px;
        margin: auto;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        border: none;
    }

    .form-header {
        background: linear-gradient(135deg, teal, #20c997);
        color: white;
        text-align: center;
        padding: 14px;
        font-size: 20px;
        font-weight: 700;
    }

    label {
        font-weight: 600;
        font-size: 13px;
        color: #444;
    }

    .form-control:focus {
        border-color: teal;
        box-shadow: 0 0 0 0.15rem rgba(0,128,128,0.25);
    }

    .btn-save {
        background: linear-gradient(135deg, teal, #20c997);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-save:hover {
            transform: scale(1.03);
            opacity: 0.95;
        }

    .btn-back {
        border-radius: 30px;
        font-size: 13px;
    }
</style>

<div class="container mt-5">

    <div class="card form-card">

        <!-- HEADER -->
        <div class="form-header">
            Create Category
        </div>

        <div class="p-4">

            <form method="post">

                <div class="mb-3">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control form-control-sm" placeholder="Enter category name" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">

                    <button type="submit" class="btn-save">
                        Save
                    </button>

                    <a asp-action="Index" class="btn btn-secondary btn-back">
                        Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}