@model FastFood.Models.Category

<style>
    .delete-card {
        max-width: 420px;
        margin: auto;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        border: none;
        background: #fff;
    }

    .delete-header {
        background: linear-gradient(135deg, #ff4d4d, #ff1a1a);
        color: white;
        text-align: center;
        padding: 14px;
        font-size: 20px;
        font-weight: 700;
    }

    label {
        font-weight: 600;
        font-size: 13px;
        color: #444;
    }

    .form-control[disabled] {
        background: #f8f9fa;
        opacity: 0.9;
    }

    .btn-delete {
        background: linear-gradient(135deg, #ff4d4d, #ff1a1a);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 8px 20px;
        font-size: 13px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-delete:hover {
            transform: scale(1.03);
            opacity: 0.95;
        }

    .btn-back {
        border-radius: 30px;
        font-size: 13px;
    }

    .warning-text {
        text-align: center;
        font-size: 13px;
        color: #ff4d4d;
        margin-bottom: 10px;
    }
</style>

<div class="container mt-5">

    <div class="card delete-card">

        <!-- HEADER -->
        <div class="delete-header">
            Delete Category
        </div>

        <div class="p-4">

            <div class="warning-text">
                ⚠️ Are you sure you want to delete this category?
            </div>

            <form asp-area="Admin"
                  asp-controller="Categories"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div class="mb-3">
                    <label>Category Name</label>
                    <input asp-for="Title" class="form-control form-control-sm" disabled />
                </div>

                <div class="d-flex justify-content-between">

                    <button type="submit" class="btn-delete">
                        Delete
                    </button>

                    <a asp-action="Index" class="btn btn-secondary btn-back">
                        Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>