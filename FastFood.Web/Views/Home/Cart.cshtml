@model IEnumerable<FastFood.Models.Cart>

@{
    ViewData["Title"] = "Cart";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">
        <span class="text-danger">Shopping</span>
        <span class="text-success">Cart</span>
    </h2>

    <div class="card shadow-lg border-0">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">🛒 Cart Items</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-danger">
                        <tr>
                            <th>Food Item</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Remove</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            double grandTotal = 0;
                        }

                        @foreach (var item in Model)
                        {
                            double total = item.Item.Price * item.Quantity;
                            grandTotal += total;

                            <tr>

                                <td class="fw-bold">
                                    @item.Item.Name
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        ₹ @item.Item.Price
                                    </span>
                                </td>

                                <td>

                                    <a asp-action="DecreaseQuantity"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        -
                                    </a>

                                    <span class="mx-2 fw-bold">
                                        @item.Quantity
                                    </span>

                                    <a asp-action="IncreaseQuantity"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success btn-sm">
                                        +
                                    </a>

                                </td>

                                <td class="fw-bold text-success">
                                    ₹ @total
                                </td>

                                <td>
                                    <a asp-action="RemoveFromCart"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm rounded-pill">
                                        Remove
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <div class="card shadow mt-4 border-0">

        <div class="card-body text-end">

            <h3>
                Grand Total :
                <span class="text-success">
                    ₹ @grandTotal
                </span>
            </h3>

            <a asp-action="Checkout"
               class="btn btn-primary btn-lg rounded-pill mt-2">
                Proceed To Checkout
            </a>

        </div>

    </div>

</div>