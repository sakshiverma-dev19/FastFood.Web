@model IEnumerable<FastFood.Models.OrderHeader>

<div class="container mt-4">

    <h2 class="text-center mb-4">
        <span class="text-danger">My</span>
        <span class="text-success">Orders</span>
    </h2>

    <div class="card shadow-lg border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Order Id</th>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Total</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="badge bg-primary">
                                        #@item.Id
                                    </span>
                                </td>

                                <td>@item.Name</td>

                                <td>@item.Phone</td>

                                <td class="fw-bold text-success">
                                    ₹ @item.OrderTotal
                                </td>

                                <td>

                                    @if (item.OrderStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (item.OrderStatus == "Preparing")
                                    {
                                        <span class="badge bg-info">
                                            Preparing
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.OrderDate.ToString("dd MMM yyyy")
                                </td>
                                <td>

                                    @if (item.Paymentstatus == "Paid")
                                    {
                                        <span class="badge bg-success">

                                            Paid

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">

                                            Pending

                                        </span>
                                    }

                                </td>
                                <td>
                                    <a asp-action="OrderDetails"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger rounded-pill">
                                        View Details
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>