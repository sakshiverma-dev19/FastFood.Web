@model IEnumerable<FastFood.Models.Item>

@{
    ViewData["Title"] = "Home";
}

<style>
    /* ===============================
          POPULAR CATEGORY CARD
    ==================================*/

    .category-card {
        background: #fff;
        border-radius: 20px;
        padding: 25px 20px;
        text-align: center;
        border: 1px solid #f1f1f1;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        transition: .35s;
        overflow: hidden;
        position: relative;
    }

        .category-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg,#ff512f,#dd2476);
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 18px 35px rgba(220,53,69,.25);
        }

    .category-icon {
        width: 80px;
        height: 80px;
        margin: auto;
        background: #fff3f4;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 40px;
        transition: .4s;
    }

    .category-card:hover .category-icon {
        transform: rotate(12deg) scale(1.15);
        background: #dc3545;
    }

    .category-card:hover .category-icon {
        color: white;
    }

    .category-card h5 {
        margin-top: 18px;
        font-weight: 700;
        color: #333;
        transition: .3s;
    }

    .category-card:hover h5 {
        color: #dc3545;
    }
</style>
<div id="loader">

    <div class="food-loader">

        <div class="burger">🍔</div>

        <div class="fries">🍟</div>

    </div>
    <h2 class="loader-title">
        Preparing Your Order...
    </h2>

    <p class="loader-subtitle">
        Fresh food is on the way 🍔
    </p>

</div>
<div class="container mt-4">

    <!-- Slider -->
    <div id="foodSlider" class="carousel slide shadow rounded overflow-hidden mb-5"
         data-bs-ride="carousel">

        <div class="carousel-indicators">
            <button type="button" data-bs-target="#foodSlider" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#foodSlider" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#foodSlider" data-bs-slide-to="2"></button>
        </div>

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="~/images/slider/Slider1.jpg"
                     class="d-block w-100 slider-img">

                <div class="carousel-caption">
                    <h2>Fresh & Delicious Burgers</h2>
                    <p>Order your favourite food online</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/slider/Slider2.jpg"
                     class="d-block w-100 slider-img">

                <div class="carousel-caption">
                    <h2>Hot & Crispy Fast Food</h2>
                    <p>Freshly prepared every day</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/slider/Slider3.jpg"
                     class="d-block w-100 slider-img">

                <div class="carousel-caption">
                    <h2>Fast Delivery</h2>
                    <p>Fresh food at your doorstep</p>
                </div>
            </div>

        </div>

    </div>

    <!-- Hero -->
    <div class="hero-box text-center mb-5">

        <h1>🍔 Fast Food Ordering System</h1>

        <p>
            Fresh • Delicious • Fast Delivery
        </p>

        <a href="#foodItems" class="btn btn-warning btn-lg">
            Order Now
        </a>

    </div>

    <!-- Search -->
    <form method="get">

        <div class="search-box">

            <div class="row">

                <div class="col-md-5">
                    <input type="text"
                           class="form-control"
                           name="search"
                           placeholder="Search Food..." />
                </div>

                <div class="col-md-5">

                    <select class="form-select"
                            name="categoryId">

                        <option value="">
                            All Categories
                        </option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.Id">
                                @category.Title
                            </option>
                        }

                    </select>

                </div>

                <div class="col-md-2">
                    <button class="btn btn-danger w-100">
                        Search
                    </button>
                </div>

            </div>

        </div>

    </form>
    <div class="container mt-5 mb-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold display-6">
                🍔 Popular Categories
            </h2>

            <p class="text-muted">
                Explore your favourite delicious foods
            </p>

            <div class="title-line"></div>

        </div>

        <div class="row g-4">

            @foreach (var category in ViewBag.Categories)
            {
                <div class="col-lg-3 col-md-4 col-6">

                    <a asp-action="Index"
                       asp-route-categoryId="@category.Id"
                       class="text-decoration-none">

                        <div class="category-card">

                            @{
                                var icon = "🍔";

                                if (category.Title == "Pizza")
                                {
                                    icon = "🍕";
                                }
                                else if (category.Title == "Drinks")
                                {
                                    icon = "";
                                }
                                else if (category.Title == "Snacks")
                                {
                                    icon = "🍟";
                                }
                                else if (category.Title == "Dessert")
                                {
                                    icon = "🍰";
                                }
                            }

                            <div class="category-icon">

                                @icon

                            </div>

                            <h5>

                                @category.Title

                            </h5>

                        </div>

                    </a>

                </div>
            }

        </div>

    </div>

    <!-- Food Cards -->

    <div class="row mt-5 g-4" id="foodItems">

        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">

                <div class="food-card">

                    <img src="~/images/items/@item.ImageUrl"
                         class="food-img">

                    <div class="food-body">

                        <span class="badge bg-danger mb-2">
                            @item.Category.Title
                        </span>

                        <h5>
                            @item.Name
                        </h5>

                        <p>
                            @item.Description
                        </p>

                        <div class="d-flex justify-content-between align-items-center">

                            <h4 class="price">
                                ₹ @item.Price
                            </h4>

                        </div>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-danger w-100 mt-3">

                            View Details

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
    <div class="container my-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Why Choose Us
            </h2>

            <p class="text-muted">
                We always provide the best quality food and fastest service.
            </p>

            <div class="title-line"></div>

        </div>

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">

                <div class="choose-card">

                    <div class="choose-icon">
                        🚚
                    </div>

                    <h4>Fast Delivery</h4>

                    <p>
                        Get your favourite food delivered quickly at your doorstep.
                    </p>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="choose-card">

                    <div class="choose-icon">
                        🍔
                    </div>

                    <h4>Fresh Food</h4>

                    <p>
                        We prepare every order using fresh and quality ingredients.
                    </p>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="choose-card">

                    <div class="choose-icon">
                        ⭐
                    </div>

                    <h4>Best Quality</h4>

                    <p>
                        Enjoy delicious food with premium taste and hygiene.
                    </p>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="choose-card">

                    <div class="choose-icon">
                        💳
                    </div>

                    <h4>Secure Payment</h4>

                    <p>
                        Multiple payment options with safe and secure checkout.
                    </p>

                </div>

            </div>

        </div>

    </div>

            <div class="container my-5">

            <div class="text-center mb-5">

    <h2 class="fw-bold">⭐ Customer Reviews</h2>

  

    <p class="text-muted mt-3">
        What Our Happy Customers Say
    </p>
            <div class="title-line"></div>

</div>
                <div class="row g-4">

                    <div class="col-lg-4">
                        <div class="review-card">

                            <div class="quote-icon">❝</div>

                            <div class="stars">★★★★★</div>

                            <p>
                                The burger was fresh and delicious. Delivery was very fast.
                                Highly recommended!
                            </p>

                            <h5>Rahul Sharma</h5>

                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="review-card">

                            <div class="quote-icon">❝</div>

                            <div class="stars">★★★★★</div>

                            <p>
                                Amazing taste, clean packaging and excellent customer service.
                            </p>

                            <h5>Priya Singh</h5>

                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="review-card">

                            <div class="quote-icon">❝</div>

                            <div class="stars">★★★★★</div>

                            <p>
                                Best fast food website. Pizza was hot, tasty and delivered on time.
                            </p>

                            <h5>Aman Verma</h5>

                        </div>
                    </div>

                </div>

            </div>


</div>
@section Scripts {
    <script>
        window.addEventListener("load", function () {

            setTimeout(function () {

                var loader = document.getElementById("loader");

                if (loader) {
                    loader.style.opacity = "0";
                    loader.style.transition = "0.3s";

                    setTimeout(function () {
                        loader.style.display = "none";
                    },300);

                }

            },400);

        });
    </script>
}