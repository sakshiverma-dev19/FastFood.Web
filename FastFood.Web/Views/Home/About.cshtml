@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold text-danger">
            About Us
        </h1>

        <p class="text-muted fs-5">
            Welcome to Fast Food Ordering System
        </p>

        <hr class="w-25 mx-auto">

    </div>

    <div class="row align-items-center">

        <div class="col-lg-6">

            <img src="~/images/about/about.jpg"
                 class="img-fluid rounded shadow-lg">

        </div>

        <div class="col-lg-6">

            <h2 class="fw-bold mb-3">
                Our Story
            </h2>

            <p class="text-muted">

                Welcome to Fast Food Ordering System, where great taste meets
                exceptional quality. We are passionate about serving fresh,
                delicious meals prepared with premium ingredients.

            </p>

            <p class="text-muted">

                From juicy burgers and cheesy pizzas to creamy pasta and crispy
                sandwiches, every dish is prepared with care by our experienced
                chefs.

            </p>

            <p class="text-muted">

                Our goal is to provide customers with hygienic food,
                affordable prices, and fast delivery.

            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-danger mt-3">

                Explore Menu

            </a>

        </div>

    </div>

</div>

<div class="container py-5">

    <h2 class="text-center fw-bold mb-5">

        Why Choose Us

    </h2>

    <div class="row g-4">

        <div class="col-md-3">

            <div class="card shadow border-0 text-center p-4 h-100">

                <i class="fa-solid fa-burger fa-3x text-danger mb-3"></i>

                <h5>Fresh Food</h5>

                <p class="text-muted">

                    Freshly prepared meals every day.

                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-0 text-center p-4 h-100">

                <i class="fa-solid fa-truck-fast fa-3x text-success mb-3"></i>

                <h5>Fast Delivery</h5>

                <p class="text-muted">

                    Quick and safe doorstep delivery.

                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-0 text-center p-4 h-100">

                <i class="fa-solid fa-user-tie fa-3x text-warning mb-3"></i>

                <h5>Expert Chefs</h5>

                <p class="text-muted">

                    Prepared by experienced professionals.

                </p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-0 text-center p-4 h-100">

                <i class="fa-solid fa-award fa-3x text-primary mb-3"></i>

                <h5>Best Quality</h5>

                <p class="text-muted">

                    High-quality ingredients and hygiene.

                </p>

            </div>

        </div>

    </div>

</div>

<!-- Mission & Vision -->

<div class="container py-5">

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card border-0 shadow-lg p-4 h-100">

                <i class="fa-solid fa-bullseye fa-3x text-danger mb-3"></i>

                <h3 class="fw-bold">Our Mission</h3>

                <p class="text-muted">

                    Our mission is to serve delicious, hygienic and affordable
                    food with fast delivery while ensuring the highest level
                    of customer satisfaction.

                </p>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card border-0 shadow-lg p-4 h-100">

                <i class="fa-solid fa-eye fa-3x text-primary mb-3"></i>

                <h3 class="fw-bold">Our Vision</h3>

                <p class="text-muted">

                    To become the most trusted online fast food ordering
                    platform by providing quality food, excellent service
                    and unforgettable customer experience.

                </p>

            </div>

        </div>

    </div>

</div>

<!-- Statistics -->

<section class="bg-danger text-white py-5">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-3">

                <h1 class="fw-bold">1000+</h1>

                <p>Happy Customers</p>

            </div>

            <div class="col-md-3">

                <h1 class="fw-bold">5000+</h1>

                <p>Orders Delivered</p>

            </div>

            <div class="col-md-3">

                <h1 class="fw-bold">50+</h1>

                <p>Food Items</p>

            </div>

            <div class="col-md-3">

                <h1 class="fw-bold">10+</h1>

                <p>Expert Chefs</p>

            </div>

        </div>

    </div>

</section>

<!-- Customer Reviews -->

<div class="container py-5">

    <h2 class="text-center fw-bold mb-5">
        What Our Customers Say
    </h2>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card border-0 shadow p-4 text-center h-100">

                <img src="~/images/about/user1.jpg"
                     class="rounded-circle mx-auto mb-3"
                     width="90"
                     height="90" />

                <h5>Rahul Sharma</h5>

                <div class="text-warning mb-2">
                    ★★★★★
                </div>

                <p class="text-muted">
                    Amazing burgers and super fast delivery.
                    Highly recommended.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow p-4 text-center h-100">

                <img src="~/images/about/user2.jpg"
                     class="rounded-circle mx-auto mb-3"
                     width="90"
                     height="90" />

                <h5>Priya Verma</h5>

                <div class="text-warning mb-2">
                    ★★★★★
                </div>

                <p class="text-muted">
                    Delicious pizza with excellent quality.
                    Loved the service.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow p-4 text-center h-100">

                <img src="~/images/about/user3.jpg"
                     class="rounded-circle mx-auto mb-3"
                     width="90"
                     height="90" />

                <h5>Amit Singh</h5>

                <div class="text-warning mb-2">
                    ★★★★★
                </div>

                <p class="text-muted">
                    Affordable prices and tasty food.
                    Will definitely order again.
                </p>

            </div>

        </div>

    </div>

</div>

<!-- Call To Action -->

<section class="container mb-5">

    <div class="bg-dark text-white rounded-4 p-5 text-center shadow-lg">

        <h2 class="fw-bold">
            Ready To Enjoy Delicious Food?
        </h2>

        <p class="mt-3">

            Explore our menu and order your favourite meal today.

        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-warning btn-lg mt-2">

            🍔 Order Now

        </a>

    </div>

</section>