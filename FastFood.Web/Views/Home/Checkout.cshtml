@model FastFood.Web.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<style>

    .checkout-card {
        max-width: 650px;
        margin: auto;
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 8px 20px rgba(0,0,0,.1);
    }

    .checkout-title {
        text-align: center;
        font-size: 30px;
        font-weight: bold;
        color: #dc3545;
        margin-bottom: 25px;
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 8px;
        height: 45px;
    }

    textarea.form-control {
        height: 80px;
    }

    .btn-order {
        background: #dc3545;
        color: white;
        width: 100%;
        height: 50px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 8px;
    }

        .btn-order:hover {
            background: #bb2d3b;
            color: white;
        }

</style>

<div class="container mt-5 mb-5">

    <div class="checkout-card">

        <div class="checkout-title">
            🍔 Checkout
        </div>
        <form asp-action="Checkout" asp-controller="Home" method="post">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Full Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Mobile Number</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">House No / Flat No</label>
                    <input asp-for="HouseNo" class="form-control" />
                    <span asp-validation-for="HouseNo" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Street / Area</label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Pincode</label>
                    <input asp-for="Pincode" class="form-control" />
                    <span asp-validation-for="Pincode" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-4">
                    <label class="form-label">Landmark (Optional)</label>
                    <textarea asp-for="Landmark" class="form-control"></textarea>
                    <span asp-validation-for="Landmark" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <button type="submit" class="btn btn-order">
                        Continue To Payment →
                    </button>
                </div>

            </div>

        </form>

    </div>
    
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}