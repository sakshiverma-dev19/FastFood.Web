@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold text-danger">
            Contact Us
        </h1>

        <p class="text-muted fs-5">
            We'd love to hear from you. Get in touch with us anytime.
        </p>

        <hr class="w-25 mx-auto text-danger" >

    </div>

    <div class="row g-4">

        <!-- Contact Form -->

        <div class="col-lg-7">

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    <h3 class="mb-4 fw-bold">
                        Send us a Message
                    </h3>

                    <form>

                        <div class="mb-3">

                            <label class="form-label">
                                Full Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter your name">

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input type="email"
                                   class="form-control"
                                   placeholder="Enter your email">

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Phone Number
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter phone number">

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Message
                            </label>

                            <textarea class="form-control"
                                      rows="5"
                                      placeholder="Write your message"></textarea>

                        </div>

                        <button class="btn btn-danger px-4">

                            <i class="fa-solid fa-paper-plane"></i>

                            Send Message

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- Contact Details -->

        <div class="col-lg-5">

            <div class="card shadow border-0 mb-4">

                <div class="card-body">

                    <h3 class="fw-bold mb-4">

                        Contact Information

                    </h3>

                    <p>

                        <i class="fa-solid fa-location-dot text-danger"></i>

                        Ayodhya, Uttar Pradesh, India

                    </p>

                    <p>

                        <i class="fa-solid fa-phone text-success"></i>

                        +91 9876543210

                    </p>

                    <p>

                        <i class="fa-solid fa-envelope text-primary"></i>

                        support@fastfood.com

                    </p>

                </div>

            </div>

            <div class="card shadow border-0">

                <div class="card-body">

                    <h3 class="fw-bold mb-4">

                        Opening Hours

                    </h3>

                    <table class="table">

                        <tr>
                            <td>Monday - Friday</td>
                            <td>9 AM - 10 PM</td>
                        </tr>

                        <tr>
                            <td>Saturday</td>
                            <td>10 AM - 11 PM</td>
                        </tr>

                        <tr>
                            <td>Sunday</td>
                            <td>10 AM - 11 PM</td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Google Map -->

<div class="container mb-5">

    <div class="card shadow border-0">

        <div class="card-body p-0">

            <iframe src="https://www.google.com/maps?q=Ayodhya&output=embed"
                    width="100%"
                    height="400"
                    style="border:0;"
                    loading="lazy">
            </iframe>

        </div>

    </div>

</div>

<!-- Social Media -->

<div class="container mb-5">

    <div class="card border-0 shadow">

        <div class="card-body text-center">

            <h3 class="fw-bold mb-4">

                Follow Us

            </h3>

            <a href="#" class="btn btn-primary me-2">

                <i class="fa-brands fa-facebook-f"></i>

            </a>

            <a href="#" class="btn btn-info me-2 text-white">

                <i class="fa-brands fa-twitter"></i>

            </a>

            <a href="#" class="btn btn-danger me-2">

                <i class="fa-brands fa-instagram"></i>

            </a>

            <a href="#" class="btn btn-success">

                <i class="fa-brands fa-whatsapp"></i>

            </a>

        </div>

    </div>

</div>

<!-- Call To Action -->

<div class="container mb-5">

    <div class="bg-danger text-white rounded-4 p-5 text-center shadow">

        <h2 class="fw-bold">

            Hungry?

        </h2>

        <p class="mt-3">

            Order your favourite food now and enjoy fresh & delicious meals.

        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-warning btn-lg">

            🍔 Order Now

        </a>

    </div>

</div>