@model IEnumerable<FastFood.Models.OrderDetails>

@{
    var order = ViewBag.Order as FastFood.Models.OrderHeader;
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">
        <span class="text-danger">Order</span>
        <span class="text-success"> Details</span>
    </h2>

    <!-- Customer Details -->

    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">👤 Customer Details</h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <p><b>Name :</b> @order.Name</p>

                    <p><b>Phone :</b> @order.Phone</p>

                    <p><b>Payment :</b> @order.PaymentMethod</p>

                    <p>

                        <b>Status :</b>

                        @if (order.OrderStatus == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else if (order.OrderStatus == "Preparing")
                        {
                            <span class="badge bg-info">
                                Preparing
                            </span>
                        }
                        else if (order.OrderStatus == "Out For Delivery")
                        {
                            <span class="badge bg-primary">
                                Out For Delivery
                            </span>
                        }
                        else if (order.OrderStatus == "Completed")
                        {
                            <span class="badge bg-success">
                                Delivered
                            </span>
                        }
                        else if (order.OrderStatus == "Cancelled")
                        {
                            <span class="badge bg-danger">
                                Cancelled
                            </span>
                        }

                    </p>

                </div>

                <div class="col-md-6">

                    <p><b>House No :</b> @order.HouseNo</p>

                    <p><b>Street :</b> @order.Street</p>

                    <p><b>City :</b> @order.City</p>

                    <p><b>Pincode :</b> @order.Pincode</p>

                    <p><b>Landmark :</b> @order.Landmark</p>

                </div>

            </div>

        </div>

    </div>

    <!-- Tracking -->

    <div class="card shadow border-0 mb-4">

        <div class="card-body">

            <h4 class="fw-bold mb-4">
                📦 Order Tracking
            </h4>

            <div class="row text-center">

                <div class="col">

                    <div class="rounded-circle mx-auto mb-2 @(order.OrderStatus=="Pending" || order.OrderStatus=="Preparing" || order.OrderStatus=="Out For Delivery" || order.OrderStatus=="Completed" ? "bg-success text-white":"bg-light")"
                         style="width:60px;height:60px;line-height:60px;font-size:25px;">

                        ✔

                    </div>

                    <strong>Pending</strong>

                </div>

                <div class="col">

                    <div class="rounded-circle mx-auto mb-2 @(order.OrderStatus=="Preparing" || order.OrderStatus=="Out For Delivery" || order.OrderStatus=="Completed" ? "bg-success text-white":"bg-light")"
                         style="width:60px;height:60px;line-height:60px;font-size:25px;">

                        👨‍🍳

                    </div>

                    <strong>Preparing</strong>

                </div>

                <div class="col">

                    <div class="rounded-circle mx-auto mb-2 @(order.OrderStatus=="Out For Delivery" || order.OrderStatus=="Completed" ? "bg-success text-white":"bg-light")"
                         style="width:60px;height:60px;line-height:60px;font-size:25px;">

                        🚚

                    </div>

                    <strong>Out For Delivery</strong>

                </div>

                <div class="col">

                    <div class="rounded-circle mx-auto mb-2 @(order.OrderStatus=="Completed" ? "bg-success text-white":"bg-light")"
                         style="width:60px;height:60px;line-height:60px;font-size:25px;">

                        🏠

                    </div>

                    <strong>Delivered</strong>

                </div>

            </div>

        </div>

    </div>

    @if (order.OrderStatus == "Pending")
    {
        <div class="mb-4">

            <a asp-action="CancelOrder"
               asp-route-id="@order.Id"
               class="btn btn-danger"
               onclick="return confirm('Are you sure you want to cancel this order?')">

                ❌ Cancel Order

            </a>

        </div>
    }

    <!-- Food Items -->

    <div class="card shadow border-0">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">
                🍔 Ordered Food Items
            </h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-hover text-center mb-0">

                <thead class="table-danger">

                    <tr>

                        <th>Food Item</th>

                        <th>Price</th>

                        <th>Quantity</th>

                        <th>Total</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.Item.Name</td>

                            <td>₹ @item.Price</td>

                            <td>@item.Count</td>

                            <td class="fw-bold text-success">

                                ₹ @(item.Price * item.Count)

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="text-center mt-4">

        <a asp-action="Orders"
           class="btn btn-danger rounded-pill px-4">

            ← Back To Orders

        </a>

    </div>

</div>