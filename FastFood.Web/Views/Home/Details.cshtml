@model FastFood.Models.Item

<div class="container mt-4">

    <div class="row">

        <div class="col-md-6">
            <img src="~/images/items/@Model.ImageUrl"
                 class="img-fluid" />
        </div>

        <div class="col-md-6">

            <h2>@Model.Name</h2>

            <p>
                <strong>Category:</strong>
                @Model.Category.Title
            </p>

            <p>
                <strong>Sub Category:</strong>
                @Model.SubCategory.Title
            </p>

            <p>
                @Model.Description
            </p>

            <h3>₹ @Model.Price</h3>

            <a asp-action="AddToCart"
               asp-route-id="@Model.Id"
               class="btn btn-success">
                Add To Cart
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>