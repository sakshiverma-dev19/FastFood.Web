@model FastFood.Web.ViewModels.RegisterViewModel

<div class="container pt-5">

    <div class="row mt-5">

        <div class="col-md-10 mx-auto shadow-lg border rounded p-5 position-relative bg-white">

            <span class="login-icon border border-success text-success position-absolute start-50 top-0 translate-middle">
                👤
            </span>

            <div class="row">

                <div class="col-md-6 text-center">

                    <h2 class="fw-bold">
                        <span class="text-danger">Create</span>
                        <span class="text-success">Account</span>
                    </h2>

                    <p class="mt-3">
                        Register and start ordering your favorite food online.
                    </p>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-success">
                        Already Have Account? Login
                    </a>

                </div>

                <div class="col-md-6">

                    <form asp-action="Register"
                          asp-controller="Account"
                          method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <input asp-for="Email"
                               class="form-control custom-input"
                               placeholder="Enter Email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                        <input asp-for="Password"
                               type="password"
                               class="form-control custom-input"
                               placeholder="Enter Password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control custom-input"
                               placeholder="Confirm Password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                        <button type="submit"
                                class="btn btn-success w-100 custom-btn">
                            Register
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>